{
  "name": "@local/dsh-connect",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Paired browser access to the running DSH host over LAN, Tailscale or Radmin VPN",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ADVOT/Remote-contral.git" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./icon": "./icon.svg", "./package.json": "./package.json" },
  "files": ["index.js", "server.js", "client.js", "ui", "icon.svg", "cordis.patch.yml"],
  "scripts": { "test": "node --test tests/*.test.js", "check": "node --check server.js && node --check index.js && node --check client.js && node --check ui/admin.js && node --check ui/pair.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"] }
  }
}
